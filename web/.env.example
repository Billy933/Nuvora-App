# Set these in Vercel project Settings > Environment Variables.
# Never commit real credentials. Do not prefix secret keys with PUBLIC or NEXT_PUBLIC.
SUPABASE_URL=https://qghtkklxewsbeaqhpkfy.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me
# Existing Vercel integrations may instead provide NEXT_PUBLIC_SUPABASE_URL,
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY / SUPABASE_ANON_KEY / NEXT_PUBLIC_SUPABASE_ANON_KEY,
# and SUPABASE_SERVICE_ROLE_KEY.
# These aliases are supported; the explicit names above take precedence.
# Generate a random secret of at least 32 characters for hashing rate-limit identities.
RATE_LIMIT_SECRET=replace-with-a-random-secret-at-least-32-characters
# Add this after the test domain is ready. Requests otherwise use the Vercel deployment origin.
PUBLIC_ORIGIN=https://nuvora.lidetdigital.com

# Browser push: generate using web-push.generateVAPIDKeys(), keep the private key server-only.
VAPID_PUBLIC_KEY=replace-with-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-vapid-private-key
VAPID_SUBJECT=https://nuvora-app-one.vercel.app
# Random 32+ character secret; save the same value in Supabase Vault for the scheduled worker.
NOTIFICATION_WORKER_SECRET=replace-with-separate-random-worker-secret
